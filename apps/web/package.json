{
  "name": "@app/web",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build --webpack && opennextjs-cloudflare build --skipBuild --skipWranglerConfigCheck && opennextjs-cloudflare populateCache local",
    "start": "next start -p 3000",
    "preview": "opennextjs-cloudflare preview",
    "db:migrate:local": "node ../../tooling/migrations/local.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "wire:fixture": "node ../../tooling/wire/render.mjs --template wrangler.template.jsonc --out wrangler.jsonc --map wiring.fixture.json --env stage"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@opennextjs/cloudflare": "1.20.11",
    "@tailwindcss/forms": "0.5.10",
    "base-x": "4.0.1",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@app/tsconfig": "workspace:*",
    "@cloudflare/workers-types": "^4.20250508.0",
    "@types/node": "^22.9.0",
    "@types/react": "19.0.12",
    "@types/react-dom": "^19",
    "autoprefixer": "10.4.21",
    "eslint": "^9.27.0",
    "eslint-config-next": "16.3.8",
    "postcss": "8.4.31",
    "tailwindcss": "3.4.17",
    "typescript": "^5.8.3",
    "wrangler": "^4.151.0"
  }
}
