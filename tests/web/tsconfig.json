{
  "extends": "../../tooling/tsconfig/web.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "node",
      "@cloudflare/workers-types"
    ],
    "paths": {
      "@web/*": [
        "../../apps/web/*"
      ],
      "lib/*": [
        "../../apps/web/lib/*"
      ],
      "pkg/*": [
        "../../apps/web/pkg/*"
      ],
      "util/*": [
        "../../apps/web/util/*"
      ],
      "@components/*": [
        "../../apps/web/app/components/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../apps/web/cloudflare-env.d.ts"
  ]
}
