// GENERATED from wrangler.template.jsonc by tooling/wire — edit the
// template, not this file. The committed copy is the fixture render
// (`pnpm run wire:fixture`); every Orun lane renders its own environment.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "envshare-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Each shared document's remaining reads and expiry, and the site's two
  // counters — Cloudflare D1. The read limit is counted here, atomically.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stg-envshare-stage",
      "database_id": "00000000-0000-0000-0000-000000000001"
    }
  ],
  // Each shared document's ciphertext and IV, with its TTL — Workers KV.
  "kv_namespaces": [
    {
      "binding": "SECRETS",
      "id": "00000000000000000000000000000001"
    }
  ]
}
